#!/usr/bin/env python3

import os
import glob
import shutil
import sys

try:
    import vtk
except ImportError:
    print("Error: vtk module not found. Try: module load python-data")
    sys.exit(1)

ARCHIVE_DIR = "pre_merge"

# Find pvtu files in current directory
pvtu_files = sorted(glob.glob("*.pvtu"))
vtu_files = glob.glob("*.vtu")

if pvtu_files:
    print(f"Found {len(pvtu_files)} .pvtu files and {len(vtu_files)} .vtu files.")

    if os.path.exists(ARCHIVE_DIR):
        print(f"\nWarning: '{ARCHIVE_DIR}' already exists.")
        answer = input("Continue and add files to it? (yes/no): ")
        if answer.strip() != "yes":
            print("Aborted.")
            sys.exit(0)
    else:
        os.makedirs(ARCHIVE_DIR)

    print(f"\nMoving original files to {ARCHIVE_DIR}/")
    all_originals = sorted(glob.glob("*.pvtu") + glob.glob("*.vtu"))
    for f in all_originals:
        shutil.move(f, os.path.join(ARCHIVE_DIR, f))
    print(f"  Moved {len(all_originals)} files.")

else:
    archive_pvtu = sorted(glob.glob(os.path.join(ARCHIVE_DIR, "*.pvtu")))
    if os.path.isdir(ARCHIVE_DIR) and archive_pvtu:
        print(f"No .pvtu files in current directory.")
        print(f"Found {len(archive_pvtu)} .pvtu files in '{ARCHIVE_DIR}/' — resuming from previous run.")
        pvtu_files = [os.path.basename(f) for f in archive_pvtu]
    else:
        print("No .pvtu files found in current directory or in 'pre_merge/'. Exiting.")
        sys.exit(0)

# Merge using VTK
print(f"\nMerging...")
for i, pvtu_file in enumerate(pvtu_files, 1):
    src = os.path.join(ARCHIVE_DIR, pvtu_file)
    out_file = os.path.splitext(pvtu_file)[0] + ".vtu"
    print(f"  [{i}/{len(pvtu_files)}] {pvtu_file} -> {out_file}")

    reader = vtk.vtkXMLPUnstructuredGridReader()
    reader.SetFileName(src)
    reader.Update()

    writer = vtk.vtkXMLUnstructuredGridWriter()
    writer.SetFileName(out_file)
    writer.SetInputData(reader.GetOutput())
    writer.Write()

print(f"\nDone. {len(pvtu_files)} merged .vtu files written to current directory.")
print(f"Original files are in '{ARCHIVE_DIR}/'.")
print(f"Verify the merged files before deleting the originals in '{ARCHIVE_DIR}/'.")
